      "datasource": {
        "type": "prometheus",
        "uid": "hotel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(rabbitmq_queue_messages_ready, \"state\", \"ready\", \"job\", \".*\") or label_replace(rabbitmq_queue_messages_unacked, \"state\", \"unacked\", \"job\", \".*\")",
