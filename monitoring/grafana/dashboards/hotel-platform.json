    {
      "id": 21,
      "type": "timeseries",
      "title": "Alertmanager notifications",
      "description": "Shows integrations that have sent at least one notification. Verify delivery at the receiver separately. No external receiver is configured by default.",
      "gridPos": {
        "x": 12,
        "y": 61,
        "w": 12,
