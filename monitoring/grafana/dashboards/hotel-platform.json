      "datasource": {
        "type": "prometheus",
        "uid": "hotel-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (integration) (rate(alertmanager_notifications_total[$__rate_interval])) and on (integration) sum by (integration) (alertmanager_notifications_total) > 0",
